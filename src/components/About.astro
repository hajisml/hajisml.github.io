---
import { asset, mine, type Site } from '../lib/site';
const { site } = Astro.props as { site: Site };
---
<section id="about" aria-labelledby="about-h">
  <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:36px">
    <h2 id="about-h" class="mvg" style="margin:0; font-weight:400; line-height:0.92; display:flex; flex-direction:column">
      <span style="font-size:clamp(22px,3vw,36px); color:rgb(var(--ink) / 0.5)">about</span>
      <span style="font-size:clamp(56px,9vw,120px)">HALIM</span>
    </h2>
  </div>
  {site.personas.map(p => {
    const facts = [...(p.focus ? [{ k: 'Focus', v: p.focus }] : []), ...mine(site.facts, p.id)];
    return (
      <div data-p={p.id} data-reveal-group style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap:20px">
        <div class="glass panel" data-reveal style="padding:clamp(24px,4vw,44px); display:flex; flex-direction:column; gap:18px">
          <div style="display:flex; align-items:center; gap:18px; padding-bottom:22px; border-bottom:1px solid rgb(var(--hi) / 0.1)">
            <div style="flex:none; display:flex; align-items:center; justify-content:center">
              <span role="img" aria-label={`${p.logoName} logo`} class="logo-mask" style={`width:56px; height:56px; background:rgb(var(--ink)); --logo:url(${asset(p.logo)})`}></span>
            </div>
            <div style="display:flex; flex-direction:column; gap:4px; min-width:0">
              <span class="mvg" style="font-size:clamp(26px,3vw,34px); line-height:1">{p.title}</span>
              <span style="font-family:inherit; font-size:12px; color:rgb(var(--ink) / 0.65)">{p.tagline}</span>
            </div>
          </div>
          <p style="margin:0; font-size:clamp(22px,2.4vw,30px); line-height:1.3; font-weight:500; text-wrap:pretty">{p.intro}</p>
          {p.about.map(para => <p style="margin:0; color:rgb(var(--ink) / 0.8); text-wrap:pretty">{para}</p>)}
          <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:8px">
            <a href={asset(site.resume)} target="_blank" rel="noopener" class="btn-solid"><span class="mi" aria-hidden="true" style="--i:url(/assets/icons/lucide/download.svg); width:17px; height:17px"></span>Download résumé</a>
            <a href="#contact" class="btn-outline"><span><span class="mi" aria-hidden="true" style="--i:url(/assets/icons/lucide/mail.svg); width:16px; height:16px"></span>Get in touch</span></a>
          </div>
        </div>
        <div class="glass panel" data-reveal style="padding:clamp(24px,4vw,44px); display:flex; flex-direction:column; gap:0">
          <div style="display:flex; align-items:center; gap:10px; padding-bottom:18px; font-family:inherit; font-size:12px; color:var(--gold)"><span style="width:8px; height:8px; border-radius:50%; background:oklch(0.8 0.13 150); box-shadow:0 0 0 4px rgba(120,220,150,0.15)"></span>{p.availability}</div>
          <dl style="margin:0; display:flex; flex-direction:column">
            {facts.map(f => (
              <div class="fact">
                <dt style="font-family:inherit; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:rgb(var(--ink) / 0.7)">{f.k}</dt>
                <dd style="margin:0; font-size:16px">{f.v}</dd>
              </div>
            ))}
            {site.education.map(e => (
              <div style="display:flex; flex-direction:column; gap:2px; padding:14px 0 0; border-top:1px solid rgb(var(--hi) / 0.1)">
                <dt style="font-family:inherit; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:rgb(var(--ink) / 0.7)">Education · {e.year}</dt>
                <dd style="margin:0; font-size:16px">{e.degree}, {e.school}</dd>
                <dd style="margin:0; font-size:14px; color:rgb(var(--ink) / 0.65)">{e.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    );
  })}
</section>
