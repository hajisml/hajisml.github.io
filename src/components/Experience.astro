---
// Alternating timeline; scripts/timeline.ts fills the rail and lights each node as you pass it.
import { mine, type Site } from '../lib/site';
const { site } = Astro.props as { site: Site };
---
<section id="experience" aria-labelledby="exp-h">
  <h2 id="exp-h" class="mvg" style="margin:0 0 36px; font-weight:400; line-height:0.92; display:flex; flex-direction:column">
    <span style="font-size:clamp(22px,3vw,36px); color:rgb(var(--ink) / 0.5)">where i've</span>
    <span style="font-size:clamp(56px,9vw,120px)">WORKED</span>
  </h2>
  {site.personas.map(p => (
    <ol data-p={p.id} data-tl class="tl">
      <span aria-hidden="true" class="tl-line"></span>
      <span aria-hidden="true" class="tl-fill" data-tl-fill></span>
      {mine(site.experience, p.id).map((x, i) => (
        <li class:list={['tl-item', i % 2 ? 'odd' : 'even']} data-reveal>
          <div class="tl-node" data-tl-node><span></span></div>
          <div class="tl-meta" data-tl-year>
            <span class="mvg" style="font-size:clamp(30px,3.6vw,54px); line-height:0.95; color:rgb(var(--ink))">{x.period}</span>
            <span style="font-size:13px; color:rgb(var(--ink) / 0.75)">{x.location}</span>
          </div>
          <div class="tl-card">
            <div class="tl-mob" style="flex-wrap:wrap; gap:4px 14px; font-size:12px; letter-spacing:0.1em; text-transform:uppercase"><span style="color:var(--gold)">{x.period}</span><span style="color:rgb(var(--ink) / 0.7)">{x.location}</span></div>
            <h3 class="mvg" style="margin:0; font-weight:400; font-size:clamp(30px,3.2vw,44px); line-height:1">{x.role}</h3>
            <span style="font-size:13px; letter-spacing:0.12em; text-transform:uppercase; color:var(--gold)">{x.company}</span>
            <ul style="list-style:none; margin:4px 0 0; padding:0; display:flex; flex-direction:column; gap:8px; max-width:48ch; color:rgb(var(--ink) / 0.82); font-size:15px">
              {x.points.map(pt => <li style="text-wrap:pretty">{pt}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  ))}
</section>
