---
import type { Persona } from '../lib/site';
const { personas } = Astro.props as { personas: Persona[] };
---
<section id="learning" aria-labelledby="learn-h">
  <h2 id="learn-h" class="mvg" style="margin:0 0 36px; font-weight:400; line-height:0.92; display:flex; flex-direction:column">
    <span style="font-size:clamp(22px,3vw,36px); color:rgb(var(--ink) / 0.5)">currently</span>
    <span style="font-size:clamp(56px,9vw,120px)">LEARNING</span>
  </h2>
  {personas.map(p => (
    <div data-p={p.id} style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap:16px">
      {p.learning.map(l => (
        <article class="glass panel" data-reveal style="padding:clamp(24px,3.6vw,40px); display:flex; flex-direction:column; gap:14px">
          <div style="display:flex; align-items:center; gap:10px; font-size:13px; letter-spacing:0.16em; text-transform:uppercase; color:var(--gold)">
            <span style="width:8px; height:8px; border-radius:50%; background:var(--gold); box-shadow:0 0 0 4px rgba(230,200,150,0.16)"></span>In progress · {l.since}
          </div>
          <h3 class="mvg" style="margin:0; font-weight:400; font-size:clamp(34px,4vw,52px); line-height:1">{l.title}</h3>
          <p style="margin:0; font-size:17px; color:rgb(var(--ink) / 0.82); text-wrap:pretty">{l.detail}</p>
          <ul style="list-style:none; margin:4px 0 0; padding:0; display:flex; flex-wrap:wrap; gap:8px">
            {l.topics.map(tp => <li class="topic">{tp}</li>)}
          </ul>
        </article>
      ))}
    </div>
  ))}
</section>
