---
// Full-screen section picker; scripts/menu.ts turns it into a scroll wheel.
import { asset, emailFor, type Site } from '../lib/site';
const { site } = Astro.props as { site: Site };
const items = [['Home', 'top'], ['Projects', 'work'], ['About', 'about'], ['Experience', 'experience'], ['Toolkit', 'skills'], ['Learning', 'learning'], ['Contact', 'contact']];
---
<div role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" class="overlay" data-menu style="position:fixed; inset:0; z-index:45; background:rgb(var(--scrim) / 0.72); backdrop-filter:blur(26px); -webkit-backdrop-filter:blur(26px); display:flex; flex-direction:column; padding:100px clamp(24px,6vw,96px) 28px">
  <div style="display:flex; justify-content:space-between; align-items:center; height:52px">
    <span style="font-family:inherit; font-size:12px; letter-spacing:0.2em; color:rgb(var(--ink) / 0.7)">MENU</span>
  </div>
  <div style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px">
    <div class="wheel-wrap" style="position:relative; width:min(620px, 100%); height:360px">
      <div aria-hidden="true" style="position:absolute; left:0; right:0; top:144px; height:72px; padding:1px; box-sizing:border-box; background:rgb(var(--ink) / 0.28); clip-path:polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px)">
        <div style="width:100%; height:100%; background:rgb(var(--glass) / 0.92); clip-path:polygon(13.6px 0, 100% 0, 100% calc(100% - 13.6px), calc(100% - 13.6px) 100%, 0 100%, 0 13.6px)"></div>
      </div>
      <span aria-hidden="true" style="position:absolute; left:18px; top:173px; width:10px; height:14px; background:var(--gold); clip-path:polygon(0 0, 100% 50%, 0 100%)"></span>
      <span aria-hidden="true" style="position:absolute; right:18px; top:173px; width:10px; height:14px; background:var(--gold); clip-path:polygon(100% 0, 0 50%, 100% 100%)"></span>
      <div data-wheel role="listbox" aria-label="Sections" tabindex="0" style="position:absolute; inset:0; overflow-y:auto; overscroll-behavior:contain; scroll-snap-type:y mandatory; scrollbar-width:none; padding:144px 0; box-sizing:border-box; outline:none; -webkit-mask-image:linear-gradient(180deg, transparent, #000 32%, #000 68%, transparent); mask-image:linear-gradient(180deg, transparent, #000 32%, #000 68%, transparent)">
        {items.map(([label, id], i) => (
          <a data-wi role="option" href={`#${id}`} class="mvg" style="height:72px; scroll-snap-align:center; display:flex; align-items:center; justify-content:center; gap:16px; padding-top:4px; box-sizing:border-box; font-size:clamp(34px,5.5vw,50px); line-height:1; color:rgb(var(--ink)); backface-visibility:hidden; will-change:transform, opacity">
            <span style="font-family:inherit; font-size:12px; letter-spacing:0.1em; opacity:0.6">0{i + 1}</span>{label}
          </a>
        ))}
      </div>
    </div>
    <span style="font-size:12px; letter-spacing:0.18em; text-transform:uppercase; text-align:center; color:rgb(var(--ink) / 0.7)">Scroll to choose · tap to open</span>
  </div>
  <div style="display:flex; flex-wrap:wrap; gap:12px 28px; font-family:inherit; font-size:13px; color:rgb(var(--ink) / 0.75)">
    <a href={asset(site.resume)} target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:8px"><span class="mi" aria-hidden="true" style="--i:url(/assets/icons/lucide/file-text.svg); width:15px; height:15px"></span>Résumé<span class="mi" aria-hidden="true" style="--i:url(/assets/icons/lucide/arrow-up-right.svg); width:13px; height:13px"></span></a>
    {site.personas.map(p => (
      <a data-p={p.id} href={`mailto:${emailFor(site, p)}`} style="display:inline-flex; align-items:center; gap:8px"><span class="mi" aria-hidden="true" style="--i:url(/assets/icons/lucide/mail.svg); width:15px; height:15px"></span>{emailFor(site, p)}</a>
    ))}
  </div>
</div>
