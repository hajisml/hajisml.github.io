---
// Toolkit grid; scripts/glow.ts moves the cursor spotlight across the cards.
import { skillGroups, type Persona } from '../lib/site';
const { personas } = Astro.props as { personas: Persona[] };
---
<section id="skills" aria-labelledby="skills-h">
  <h2 id="skills-h" class="mvg" style="margin:0 0 36px; font-weight:400; line-height:0.92; display:flex; flex-direction:column">
    <span style="font-size:clamp(22px,3vw,36px); color:rgb(var(--ink) / 0.5)">the</span>
    <span style="font-size:clamp(56px,9vw,120px)">TOOLKIT</span>
  </h2>
  {personas.map(p => (
    <div data-p={p.id} data-glow-area style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap:16px">
      {skillGroups(p).map(g => (
        <div class="glow-card" data-glow data-reveal>
          <div style="display:flex; align-items:baseline; gap:14px; padding-bottom:16px; border-bottom:1px solid rgb(var(--hi) / 0.1)">
            <span class="mvg" style="font-size:30px; line-height:1; color:var(--gold)">{g.num}</span>
            <h3 style="margin:0; flex:1; font-family:inherit; font-size:13px; letter-spacing:0.18em; text-transform:uppercase; font-weight:500">{g.group}</h3>
            <span style="font-size:12px; white-space:nowrap; color:rgb(var(--ink) / 0.68)">{g.count}</span>
          </div>
          <ul style="list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fill, minmax(96px, 1fr)); gap:8px">
            {g.items.map(it => (
              <li class="glow-item" data-glow>
                <span aria-hidden="true" style={`flex:none; width:${it.size}; height:${it.size}; background:currentColor; clip-path:${it.clip}; mask-image:${it.mask}; -webkit-mask-image:${it.mask}; mask-size:contain; -webkit-mask-size:contain; mask-repeat:no-repeat; -webkit-mask-repeat:no-repeat; mask-position:center; -webkit-mask-position:center`}></span>
                <span style="font-size:12.5px; line-height:1.25; text-wrap:balance">{it.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ))}
</section>
