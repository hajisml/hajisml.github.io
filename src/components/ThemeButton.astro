---
// The "nuclear" light/dark toggle. Its label and pressed state are set by scripts/theme.ts.
const { small = false } = Astro.props as { small?: boolean };
---
<button class:list={['nuke-btn', { sm: small }]} data-theme-btn aria-label="Nuclear mode off — turn on" aria-pressed="false" title="Nuclear mode off — turn on">
  <span class="nuke" data-nuke aria-hidden="true">
    <span data-nuke-wave style="position:absolute; inset:0; border-radius:50%; border:1.5px solid currentColor; opacity:0"></span>
    <svg viewBox="0 -0.9 26 26" style="position:absolute; inset:0; width:100%; height:100%; overflow:visible">
      <path class="nuke-fill" data-nuke-blades d="M7.20 2.95 A11.6 11.6 0 0 1 18.80 2.95 L15.60 8.50 A5.2 5.2 0 0 0 10.40 8.50 Z M24.60 13.00 A11.6 11.6 0 0 1 18.80 23.05 L15.60 17.50 A5.2 5.2 0 0 0 18.20 13.00 Z M7.20 23.05 A11.6 11.6 0 0 1 1.40 13.00 L7.80 13.00 A5.2 5.2 0 0 0 10.40 17.50 Z" fill="currentColor" stroke-width="1.6" stroke-linejoin="round" style="stroke:currentColor; transition:fill-opacity .45s ease .15s; transform-box:view-box; transform-origin:13px 12.1px"></path>
      <circle class="nuke-fill" data-nuke-core cx="13" cy="13" r="2.4" fill="currentColor" stroke-width="1.6" style="stroke:currentColor; transition:fill-opacity .45s ease; transform-box:view-box; transform-origin:13px 13px"></circle>
    </svg>
  </span>
</button>
