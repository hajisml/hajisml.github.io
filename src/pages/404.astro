---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Haji Ibrahim" description="This page doesn't exist." variant="page">
  <main id="main" style="position:relative; z-index:3; max-width:1080px; margin:0 auto; min-height:70vh; padding:clamp(140px,18vw,200px) clamp(16px,4vw,40px) 64px; box-sizing:border-box; display:flex; flex-direction:column; align-items:flex-start; gap:20px">
    <h1 class="mvg" style="margin:0; font-weight:400; line-height:0.92; display:flex; flex-direction:column">
      <span style="font-size:clamp(22px,3vw,36px); color:rgb(var(--ink) / 0.6)">page not</span>
      <span style="font-size:clamp(64px,10vw,132px)">FOUND</span>
    </h1>
    <p style="margin:0; max-width:42ch; color:rgb(var(--ink) / 0.8)">That link doesn't lead anywhere. The work, the blog and a way to reach me are all a click away.</p>
    <div style="display:flex; flex-wrap:wrap; gap:12px">
      <a href="/" class="btn-solid">Back home</a>
      <a href="/blog/" class="btn-outline"><span>Read the blog</span></a>
    </div>
  </main>
</Base>
